{
	"schemaVersion": 1,
	"id": "metacraft-loot-containers",
	"version": "${version}",
	"name": "METAcraft Loot Containers",
	"description": "Chests that automatically refill with loot",
	"authors": [
		"Acuadragon100"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.loot_containers.METAcraftLootContainers"
		]
	},
	"mixins": [
		"metacraft_loot_containers.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": "*",
		"metacraft-lib": "*"
	}
}
