{
  "schemaVersion": 1,
  "id": "simple-custom-features",
  "version": "${version}",

  "name": "SimpleCustomFeatures",
  "description": "A mod that allows the creation of simple custom features from a config file.",
  "authors": [
    "Acuadragon100"
  ],
  "contributors": [],
  "contact": {
    "sources": "${git_repo}",
    "homepage": "${website}",
    "issues": "${issues}"
  },

  "license": "Apache-2.0",
  "icon": "assets/simple_custom_features/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
		"nu.metacraft.simplecustomfeatures.Features"
    ],
    "client": [
		"nu.metacraft.simplecustomfeatures.Features"
    ],
    "server": [
		"nu.metacraft.simplecustomfeatures.Features"
    ]
  },
  "mixins": [
	  "simple-custom-features.mixins.json"
  ],
  "accessWidener" : "simple-custom-features.classtweaker",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "metacraft-lib": "*",
    "polymer-core": "*"
  }
}
