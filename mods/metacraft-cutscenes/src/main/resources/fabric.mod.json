{
	"schemaVersion": 1,
	"id": "metacraft-cutscenes",
	"version": "${version}",
	"name": "METAcraft-Cutscenes",
	"description": "Adds data-driven cutscenes",
	"authors": [
		"Acuadragon100"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.cutscenes.Cutscenes"
		]
	},
	"mixins": [
		"cutscenes.mixins.json"
	],
	"accessWidener": "metacraft_cutscenes.classtweaker",
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": "*",
		"metacraft-core": "*"
	}
