{
	"schemaVersion": 1,
	"id": "museum-collection",
	"version": "${version}",
	"name": "Museum Collection Competition",
	"description": "An item collection event between three teams: players register items with a collector villager, stored in MySQL for the website.",
	"authors": [
		"Oscar Eriksson"
	],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"se.metacraft.museum_collection.MuseumCollection"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"metacraft-lib": "*",
		"metacraft-config": "*"
	},
	"suggests": {
		"metacraft-skins": "*"
	}
}
