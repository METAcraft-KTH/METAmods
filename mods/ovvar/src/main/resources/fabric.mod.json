{
	"schemaVersion": 1,
	"id": "ovvar",
	"version": "${version}",
	"name": "Ovvar",
	"description": "Student overalls (ovvar) with sewn-on patches for vanilla clients, via Polymer. Players only need the auto-served resource pack.",
	"authors": [
		"Edvin"
	],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"se.metacraft.ovvar.Ovvar"
		],
		"fabric-gametest": [
			"se.metacraft.ovvar.gametest.DanseShellParityTests",
			"se.metacraft.ovvar.gametest.DanseModelsTests",
			"se.metacraft.ovvar.gametest.DanseLayersTests",
			"se.metacraft.ovvar.gametest.DanseForkTests",
			"se.metacraft.ovvar.gametest.OvvarGameTests",
			"se.metacraft.ovvar.gametest.ComboPackTests",
			"se.metacraft.ovvar.gametest.FrackTests",
			"se.metacraft.ovvar.gametest.WardrobeTests",
			"se.metacraft.ovvar.gametest.BlockbenchManifestTests"
		],
		"fabric-datagen": [
			"se.metacraft.ovvar.datagen.OvvarDataGenerator"
		]
	},
	"mixins": [
		"ovvar.mixins.json",
		"ovvar-danse.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": ">=26.3-rc.1 <26.4",
		"java": ">=25",
		"fabric-api": "*",
		"metacraft-config": "*",
		"polymer-core": "*",
		"polymer-resource-pack": "*",
		"polymer-virtual-entity": "*",
		"sgui": "*",
		"metacraft-bundles": "*",
		"booklet": "*"
	},
	"suggests": {
		"metacraft-resource-packs": "*"
	}
}
