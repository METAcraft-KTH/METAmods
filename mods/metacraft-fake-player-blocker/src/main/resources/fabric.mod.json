{
	"schemaVersion": 1,
	"id": "metacraft-fake-player-blocker",
	"version": "${version}",
	"name": "Fake Player Blocker",
	"description": "Stops players from teleporting with fake players.",
	"authors": [
		"Acuadragon100"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/portal-blocker/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.fake_player_blocker.FakePlayerBlocker"
		]
	},
	"mixins": [
		"metacraft-fake-player-blocker.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": "*",
		"metacraft-lib": "*"
	},
	"suggests": {
		"puppet-players": "*",
		"carpet": "*"
	}
}