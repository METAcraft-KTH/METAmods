{
	"schemaVersion": 1,
	"id": "metacraft-shaders",
	"version": "${version}",
	"name": "METAcraft-Shaders",
	"description": "Shaders shared by the METAcraft mods, sent in the Polymer resource pack.",
	"authors": [
		"Froosty11"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"se.metacraft.shaders.METAcraftShaders"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": "*",
		"metacraft-lib": "*",
		"polymer-resource-pack": "*"
	}
}
