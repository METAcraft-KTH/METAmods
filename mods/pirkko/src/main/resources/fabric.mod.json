{
	"schemaVersion": 1,
	"id": "pirkko",
	"version": "${version}",
	"name": "Pirkko",
	"description": "Hostile cave Pirkkos that drop matching placeable Pirkko heads, for vanilla clients through Polymer.",
	"authors": [
		"ripSquid"
	],
	"contributors": [
		"Ainrave"
	],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"se.metacraft.pirkko.Pirkko"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"polymer-core": "*",
		"polymer-virtual-entity": "*",
		"polymer-resource-pack": "*"
	}
}
