{
	"schemaVersion": 1,
	"id": "portable-jukebox",
	"version": "${version}",
	"name": "PortableJukebox",
	"description": "Portable jukeboxes that can play music while in your inventory",
	"authors": [
		"Acuadragon100"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft/icon.png",
	"accessWidener" : "portable_jukebox.classtweaker",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.portable_jukebox.PortableJukebox"
		]
	},
	"mixins": [
		"portable_jukebox.mixins.json",
		"portable_jukebox.compat.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": "*",
		"metacraft-lib": "*",
		"polymer-core": "*",
		"sgui": "*"
	}
}
