{
	"schemaVersion": 1,
	"id": "metacraft-season-4",
	"version": "${version}",
	"name": "METAcraft-Core",
	"description": "METAcraft-Season-4 specific features.",
	"authors": [
		"Acuadragon100",
		"Alvinn8"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.season_4.Season4"
		],
		"fabric-datagen": [
			"nu.metacraft.season_4.Season4Datagen"
		]
	},
	"mixins": [
		"metacraft_season_4.mixins.json"
	],
	"accessWideners" : "metacraft_season_4.accesswidener",
	"depends": {
		"fabricloader": ">=${loader_version}",
		"fabric": "*",
		"minecraft": "~${minecraft_version}",
		"metacraft-lib": "*",
		"metacraft-cutscenes": "*"
	},
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/entity/LivingEntity": [
				"nu/metacraft/season_4/extensions/DragExtension",
				"nu/metacraft/season_4/extensions/SurviveDeathExtension"
			]
		}
	}
}
