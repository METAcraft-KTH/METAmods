{
	"schemaVersion": 1,
	"id": "nether-rifts",
	"version": "${version}",
	"name": "Nether Rifts",
	"description": "Until the realm is stabilised, nether portals open into rifts that raid the overworld.",
	"authors": ["Froosty11"],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"environment": "*",
