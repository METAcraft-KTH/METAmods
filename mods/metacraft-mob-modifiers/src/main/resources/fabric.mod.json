{
	"schemaVersion": 1,
	"id": "metacraft-mob-modifiers",
	"version": "${version}",
	"name": "METAcraft Mod Modifiers",
	"description": "Various optional modifiers to mobs.",
	"authors": [
		"Acuadragon100"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.mob_modifiers.METAcraftMobModifiers"
		]
	},
	"mixins": [
		"metacraft_mob_modifiers.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"fabric-api": "*",
		"minecraft": "~${minecraft_version}",
		"metacraft-lib": "*"
