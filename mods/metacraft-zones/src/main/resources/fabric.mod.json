{
	"schemaVersion": 1,
	"id": "metacraft-zones",
	"version": "${version}",
	"name": "METAcraft-Zones",
	"description": "METAcraft zone library, used for handling zones.",
	"authors": [
		"Acuadragon100"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft_zones/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.zones.METAcraftZones"
		]
	},
	"accessWidener" : "metacraft_zones.accesswidener",
	"mixins": [
		"metacraft-zones.mixins.json",
		"metacraft-zones.compat.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric": "*",
		"metacraft-lib": "*"
	},
	"suggests": {
		"leukocyte": "*"
	}
}