{
	"schemaVersion": 1,
	"id": "metacraft-relay",
	"version": "${version}",
	"name": "METAcraft-Relay",
	"description": "METAcraft-Relay, serverside implementation of Kendian's End Relay idea.",
	"authors": [
		"Acuadragon100"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.relay.Relay"
		],
		"fabric-datagen": [
			"nu.metacraft.relay.RelayDatagen"
		]
	},
	"accessWidener" : "metacraft_relay.classtweaker",
	"mixins": [
		"metacraft_relay.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"fabric-api": "*",
		"minecraft": "~${minecraft_version}",
		"metacraft-lib": "*",
		"metacraft-core": "*"
	}
}
