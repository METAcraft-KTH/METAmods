{
	"schemaVersion": 1,
	"id": "metacraft_lib",
	"version": "${version}",
	"name": "METAcraft-Lib",
	"description": "The central libraries used by our other mods.",
	"authors": [
		"Acuadragon100"
	],
	"contributors": [],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "Apache-2.0",
	"icon": "assets/metacraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"se.datasektionen.mc.metacraft_lib.METAcraftLib"
		]
	},
	"mixins": [
		"metacraft_lib.mixins.json"
	],
	"accessWidener" : "metacraft_lib.accesswidener",
	"depends": {
		"fabricloader": ">=${loader_version}",
		"fabric": "*",
		"minecraft": "${minecraft_version}"
	}
}
